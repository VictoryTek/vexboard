{
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(cargo fmt --all -- --check:*)",
      "Bash(cargo clippy --workspace -- -D warnings:*)",
      "Bash(cargo test -p vexboard-server:*)",
      "Bash(cargo build --release --bin vexboard-server:*)",
      "Bash(cargo audit --ignore RUSTSEC-2023-0071:*)",
      "Bash(powershell -File scripts/preflight.ps1:*)",
      "Bash(./scripts/preflight.sh:*)",
      "Bash(bash scripts/preflight.sh:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(cargo build --workspace:*)",
      "Bash(cargo test --all-targets:*)",
      "Bash(docker build:*)",
      "Bash(trunk build:*)",
      "Bash(trunk serve:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
